// DEPRECATED — the Stencil issuer (auth.usingopen.com) is superseded by
// WorkOS AuthKit: sign in with `usingopen` (auth/usingopen.kdl) instead.
// Kept during the transition so existing Stencil credentials and
// STENCIL_*-overriden local development keep working; the login entry is
// still listed for accounts that have not re-authenticated yet.
//
// usingopen.com account. Not a model provider: the credential authorizes
// usingopen-hosted Stencil services such as `usingopen stream` (live.usingopen.com).
//
// Two hosts: the Stencil API at api.usingopen.com (`{base}`, STENCIL_BASE_URL)
// and the OIDC issuer at auth.usingopen.com (`{auth}`, STENCIL_AUTH_URL) which
// serves the PKCE-mandatory authorization codes under /oauth/* and mints
// ES256 access tokens. The public client id `usingopen` is code-defined in the
// issuer with a port-flexible 127.0.0.1 loopback callback.
auth "stencil" {
	name "Stencil (deprecated)"
	env "STENCIL_API_KEY"
	login "oauth-code" {
		client-id "usingopen" env="STENCIL_CLIENT_ID"
		base-url "https://api.usingopen.com" {
			env "STENCIL_BASE_URL"
		}
		auth-url "https://auth.usingopen.com" {
			env "STENCIL_AUTH_URL"
		}
		authorize-url "{auth}/oauth/authorize"
		scopes "openid" "profile" "email" "offline_access"
		pkce #true
		instructions "Sign in to your usingopen.com account in the browser. If the browser cannot reach this machine, paste the final redirect URL when prompted."
		callback port=54547 path="/callback" hostname="127.0.0.1" redirect-uri-env="STENCIL_REDIRECT_URI"
		token url="{auth}/oauth/token" body="form"
		credential {
			access "access_token"
			refresh "refresh_token"
			expires "seconds" path="expires_in" skew-ms=300000
		}
		userinfo url="{auth}/oauth/userinfo" email="email" account-id="sub"
	}
	refresh {
		token url="{auth}/oauth/token" body="form"
	}
}
