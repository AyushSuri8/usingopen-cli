{
  "type": "module",
  "name": "@usingopen/tui",
  "version": "18.8.9",
  "description": "Terminal User Interface library with differential rendering for efficient text-based applications",
  "homepage": "https://usingopen.com",
  "author": { "name": "UsingOpen", "url": "https://usingopen.com" },
  "contributors": [
    "Mario Zechner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git.usingopen.com/usingopen/usingopen.git",
    "directory": "packages/tui"
  },
  "bugs": {
    "url": "https://git.usingopen.com/usingopen/usingopen/issues"
  },
  "keywords": [
    "tui",
    "terminal",
    "ui",
    "text-editor",
    "differential-rendering",
    "typescript",
    "cli"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "test": "bun test --parallel test/*.test.ts",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'",
    "gen:glyphs": "bun scripts/gen-glyphs.ts"
  },
  "dependencies": {
    "@usingopen/omptype": "catalog:",
    "@usingopen/agent-core": "catalog:",
    "@usingopen/ai": "catalog:",
    "@usingopen/catalog": "catalog:",
    "@usingopen/natives": "catalog:",
    "@usingopen/utils": "catalog:",
    "@usingopen/wire": "catalog:",
    "@usingopen/snapcompact": "catalog:"
  },
  "devDependencies": {
    "kitty-vt-wasm": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./theme/defaults": {
      "types": "./src/theme/defaults/index.ts",
      "import": "./src/theme/defaults/index.ts"
    },
    "./theme/*": {
      "types": "./src/theme/*.ts",
      "import": "./src/theme/*.ts"
    },
    "./render": {
      "types": "./src/render/index.ts",
      "import": "./src/render/index.ts"
    },
    "./chrome": {
      "types": "./src/chrome/index.ts",
      "import": "./src/chrome/index.ts"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "import": "./src/tools/index.ts"
    },
    "./status-line": {
      "types": "./src/status-line/index.ts",
      "import": "./src/status-line/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./components/*": {
      "types": "./src/components/*.ts",
      "import": "./src/components/*.ts"
    },
    "./native/*": {
      "types": "./src/native/*.ts",
      "import": "./src/native/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
